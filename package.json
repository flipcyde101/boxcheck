{
  "name": "boxcheck",
  "version": "0.1.0",
  "description": "100% local, <500-token DOM geometry, CSS cascade & layout-collision oracle (CLI + MCP) for coding agents — raw CDP over Node 24 WebSocket, zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flipcyde101/boxcheck.git"
  },
  "homepage": "https://github.com/flipcyde101/boxcheck#readme",
  "bugs": {
    "url": "https://github.com/flipcyde101/boxcheck/issues"
  },
  "bin": {
    "boxcheck": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "css",
    "layout",
    "dom",
    "cdp",
    "mcp",
    "claude-code",
    "antigravity",
    "codex",
    "cursor",
    "visual-regression",
    "frontend",
    "testing"
  ],
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
